# Copy to .env before `docker compose up`. .env is Git-ignored; never commit it.

# Run containers as your host user so generated artifacts are not owned by root.
# Linux/macOS: id -u    Windows (Docker Desktop): leave the default.
AIRFLOW_UID=50000

# Local development login for the Airflow UI. Change both before exposing this
# to anything other than localhost.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@localhost

# Optional. Without these, task failures still appear in the UI and the logs,
# but no email is delivered.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM=airflow@localhost
